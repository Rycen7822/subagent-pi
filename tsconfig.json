{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "typeRoots": ["node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "typebox": ["node_modules/pi-host/node_modules/typebox/build/index.d.mts"],
      "@earendil-works/pi-coding-agent": ["node_modules/pi-host/dist/index.d.ts"],
      "@types/node": ["node_modules/pi-host/node_modules/@types/node"]
    }
  },
  "include": ["extensions/**/*.ts"]
}
